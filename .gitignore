# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Environment
.env
.env.local
*.local

# Build artifacts
build/
*.apk
*.aab
*.ipa

# Generated privacy pages (derived from store-listing/privacy.config.json; publish to
# the focalstudio.github.io repo instead of committing here). Keep the committed sources.
store-listing/privacy-*.html
!store-listing/privacy-policy-template.html
!store-listing/privacy-chrome.html

# Per-app privacy config is committed; the example is the shared template.

# OS
.DS_Store
*.sw?

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Claude Code local files (personal, not shared)
# Note: .claude/skills/ IS committed (vendored skill packs shared with the template).
# Only personal local-only files are ignored.
.claude/settings.local.json
.claude/scratch/
IMPROVEMENTS.txt

# iOS — only the Xcode Cloud CI scripts are committed; the rest is generated by expo prebuild
/ios/*
!/ios/ci_scripts/

# Android — generated by expo prebuild; EAS manages the keystore remotely
android/

# EAS / Expo secrets (never commit)
google-services.json
GoogleService-Info.plist
*.jks
play-service-account.json
